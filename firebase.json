{
  "hosting": {
    "site": "englishboard",
    "public": "dist",
    "cleanUrls": true,
    "redirects": [
      { "source": "/", "destination": "/app", "type": 302 }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/@(app|curriculum|teaching-plan)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
